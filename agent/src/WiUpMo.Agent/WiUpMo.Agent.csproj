<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WiUpMo.Agent</RootNamespace>
    <AssemblyName>wiupmo-agent</AssemblyName>
    <Version>0.9.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Der Zugriff auf WUApi laeuft ueber spaete Bindung (IDispatch). Der
      typisierte Weg ueber <COMReference> scheidet aus: die MSBuild-Aufgabe
      ResolveComReference gibt es nur im .NET-Framework-MSBuild aus Visual
      Studio, nicht unter `dotnet build` — das waere eine VS-Abhaengigkeit
      fuer jeden Build und jede CI.
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!--
      Fuer die Meldung beim Benutzer, wenn ein Neustart angefordert ist. Sie
      laeuft als eigener Prozess dieser EXE in der Sitzung des Benutzers.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Das Backend-Image baut den Agent unter Linux. Fuer die Windows-Frameworks
      (hier Windows Forms) verlangt das SDK dort diese ausdrueckliche Freigabe.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      Wird beim Publish zu einer einzelnen EXE mit mitgelieferter Runtime.
      Kein PublishTrimmed: Trimming wuerde die fuer die spaete Bindung
      benoetigten Metadaten entfernen.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Etwa halb so gross: kuerzere Downloads beim Selbst-Update, weniger
      Abbrueche ueber VPN. Entpackt wird beim Start in den Speicher.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Nur fuer den Ende-zu-Ende-Test: eine Fassung, die startet, aber im ersten
    Durchlauf scheitert. Beim Bauen gesetzt, nicht ueber die Konfiguration —
    eine ausgelieferte EXE kann sie also nie sein.
  -->
  <PropertyGroup Condition="'$(WiUpMoE2EBroken)' == 'true'">
    <DefineConstants>$(DefineConstants);E2E_BROKEN</DefineConstants>
  </PropertyGroup>

  <!--
    Die impliziten Usings von Windows Forms wuerden mit bestehenden Namen
    kollidieren (Timer, Message); die Meldung bindet sie ausdruecklich ein.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
