# Kopie als .env neben der docker-compose.yml anlegen. .env ist per .gitignore
# ausgeschlossen.

# --- Image -------------------------------------------------------------------
# Der Stack startet dieses Image, er baut es nicht. Gebaut wird in der CI.
#
# Ohne Angabe gilt der Standardwert aus der docker-compose.yml:
# ghcr.io/lucakuehne/wiupmo/backend:main — der jeweils letzte Stand von main.
# Das ist fuer die Testphase gedacht: pushen genuegt, es ist nichts einzutragen.
#
# Fuer den produktiven Betrieb hier eine feste Version eintragen, damit
# nachvollziehbar bleibt, welcher Stand laeuft:
#   BACKEND_IMAGE=ghcr.io/lucakuehne/wiupmo/backend:0.1.0
# BACKEND_IMAGE=

# --- Datenbank ---------------------------------------------------------------
DB_USER=wiupmo
DB_NAME=wiupmo
# Pflichtangabe. Erzeugen z. B. mit:
#   openssl rand -base64 32
DB_PASSWORD=

# --- Agent-Enrollment (optional, nur Erstbefuellung) --------------------------
# Das Enrollment-Token liegt in den Einstellungen und wird im Frontend
# abgelesen und erneuert. Leer lassen: Das Backend erzeugt beim ersten Start
# selbst eines.
#
# Nur setzen, wenn bereits Agents mit einem bestimmten Wert verteilt wurden.
AGENT_ENROLLMENT_TOKEN=

# --- Netzwerk ----------------------------------------------------------------
# Port auf dem Host. Im Container hoert das Backend immer auf 3000 — hier steht
# nur, unter welchem Port es von aussen erreichbar ist. Anpassen, wenn auf dem
# Host bereits etwas anderes auf 3000 laeuft.
HOST_PORT=3000
# 0.0.0.0 veroeffentlicht den Port auf allen Schnittstellen des Hosts. Steht ein
# Reverse Proxy davor, gehoert hier 127.0.0.1 hin.
BIND_ADDRESS=0.0.0.0

# Kommagetrennte Liste erlaubter Herkuenfte fuer das Frontend. Leer lassen,
# solange das Frontend aus demselben Container ausgeliefert wird.
CORS_ORIGINS=

# --- Active Directory (optional, nur Erstbefuellung) --------------------------
# Die AD-Anbindung wird im Frontend unter "Einstellungen" gepflegt und liegt in
# der Datenbank. Diese Variablen fuellen sie beim allerersten Start — danach
# werden sie nicht mehr gelesen, und Aenderungen daran haben keine Wirkung mehr.
#
# Sie koennen also leer bleiben; es ist bequemer, alles im Frontend einzugeben.
AD_URL=
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_FILTER=(objectClass=computer)
AD_SYNC_INTERVAL_MINUTES=360
AD_STARTUP_DELAY_SECONDS=60
AD_TLS_REJECT_UNAUTHORIZED=true

# --- Anmeldung ---------------------------------------------------------------
# Auf true setzen, sobald ein Reverse Proxy mit TLS davorsteht. Ueber http
# wuerde der Browser ein Cookie mit Secure-Kennzeichen verwerfen und niemand
# koennte sich anmelden.
COOKIE_SECURE=false

# Optional. Ohne Angabe erzeugt das Backend beim ersten Start ein Geheimnis und
# legt es in den Einstellungen ab. Setzen, wer mehrere Instanzen betreibt oder
# gezielt alle Sitzungen entwerten koennen will. Mindestens 32 Zeichen.
JWT_SECRET=
