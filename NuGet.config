<?xml version="1.0" encoding="utf-8"?>
<!--
  Projektlokale Paketquelle.

  Auf dem Entwicklungsrechner ist in der Benutzerkonfiguration keine Quelle
  hinterlegt (leeres <packageSources>), eine maschinenweite Richtlinie gibt es
  nicht. Statt die globale Konfiguration zu veraendern, legt das Projekt seine
  Quelle selbst fest — das macht den Build auf jedem Rechner und in der CI
  gleich, ohne Vorbedingungen an die Umgebung.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
