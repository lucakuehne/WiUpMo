# Kopie als .env anlegen und Werte setzen. .env ist per .gitignore ausgeschlossen.

NODE_ENV=development
PORT=3000

# --- Datenbank ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=wiupmo
DB_PASSWORD=bitte-aendern
DB_NAME=wiupmo
DB_SSL=false

# --- Agent-Enrollment --------------------------------------------------------
# Gemeinsames Geheimnis, das der Agent beim erstmaligen Registrieren vorlegt.
# Danach arbeitet jedes Geraet mit einem eigenen, serverseitig erzeugten Secret.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_ENROLLMENT_TOKEN=

# --- Frontend ----------------------------------------------------------------
# Kommagetrennte Liste erlaubter Herkuenfte. Leer lassen, wenn das Frontend vom
# selben Container ausgeliefert wird.
CORS_ORIGINS=http://localhost:5173
