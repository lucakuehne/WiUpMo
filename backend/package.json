{
  "name": "wium-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Update Monitoring — Backend (NestJS)",
  "license": "UNLICENSED",
  "//type": "NestJS 12 ist ESM-only (@nestjs/common hat type: module), deshalb ist auch dieses Paket ESM.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "//migrations": "Laufen gegen das kompilierte Ergebnis. Der ts-node-Weg der TypeORM-CLI ist unter ESM unzuverlaessig, und im Container laeuft ohnehin das Kompilat.",
    "migration:run": "pnpm build && typeorm -d dist/src/database/data-source.js migration:run",
    "migration:revert": "pnpm build && typeorm -d dist/src/database/data-source.js migration:revert",
    "migration:show": "pnpm build && typeorm -d dist/src/database/data-source.js migration:show",
    "//check:openapi": "Faengt DTOs ab, an denen SwaggerModule.createDocument beim Start scheitern wuerde. Braucht keine Datenbank.",
    "check:openapi": "node scripts/check-openapi.mjs",
    "//test:unit": "Eingebauter Testlaeufer von Node, laeuft gegen das Kompilat. Braucht kein Jest und keine Konfiguration.",
    "test:unit": "node --test \"test/**/*.test.mjs\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@node-rs/argon2": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ldapts": "^9.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
